<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ask your Mac</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<dict>
				<!--
				  The dictionary form rather than a predicate: the three things worth
				  sending to a model are a selection of text, a page, and a picture,
				  and a hand-written NSPredicate is a well-known way to end up with an
				  extension that never appears in the share sheet at all.

				  These keys belong inside NSExtensionActivationRule, not beside it.
				  Put directly under NSExtensionAttributes they parse, install and
				  register with PlugInKit — `pluginkit -mAv` lists the extension and
				  the log shows it elected — and no app ever offers it, because the
				  rule the share sheet actually reads is absent and so matches nothing.

				  Deliberately no NSExtensionActivationSupportsWebPageWithMaxCount:
				  that one asks Safari to run a JavaScript preprocessing file inside
				  the page, which needs NSExtensionJavaScriptPreprocessingFile. The
				  URL is what we want anyway — the model is asked about the page, not
				  about its DOM.
				-->
				<key>NSExtensionActivationSupportsText</key>
				<true/>
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>1</integer>
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>8</integer>
			</dict>
		</dict>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The app's exception, for the app's reason. TailnetHost is the gate. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
