<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Silicon Buddy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>To scan the pairing code your Mac shows, and to send a photo to a vision model.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To attach a picture to a message for a vision model.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>To reach Silicon Optimizer on your Mac when it is on the same network rather than the tailnet.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>To unlock Silicon Buddy without typing your passcode.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		  The control API is plain HTTP on a private address, and there is no
		  certificate on a tailnet to validate. NSAllowsLocalNetworking covers
		  loopback and the RFC1918 ranges, which is the Simulator and a LAN; the
		  Mac's own listener binds 100.64/10 (Tailscale's range) or loopback and
		  nothing else, and ATS has no way to spell a range, so the tailnet needs
		  an exception of its own.

		  NSAllowsArbitraryLoads is deliberately absent: everything this app dials
		  is checked against TailnetHost first, and an HTTPS URL anywhere else in
		  the app still has to be HTTPS.
		-->
		<!--
		  Measured, not assumed: with only NSAllowsLocalNetworking, a request to the
		  Mac's tailnet address fails with NSURLErrorDomain -1022 ("App Transport
		  Security policy requires the use of a secure connection"), because
		  local networking covers loopback and RFC1918 but not 100.64/10, and ATS
		  has no syntax for an address range. The Mac binds its Silicon Buddy
		  listener to a raw 100.64/10 address and puts that address in the QR, so
		  without this the product's main path does not work at all.

		  What keeps this narrow is not ATS: it is TailnetHost, which every request
		  passes through, and which refuses any host that is not loopback, the
		  emulator's 10.0.2.2, 100.64/10 or fd7a:115c:a1e0::/48. See
		  PairingSecurityTests and ControlClientTests.
		-->
		<!--
		  NSAllowsLocalNetworking is deliberately absent: when it is present, iOS
		  ignores NSAllowsArbitraryLoads entirely, and the tailnet is refused again.
		  Measured, both ways, on the Simulator against a real tailnet address.
		-->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- Tailscale's MagicDNS names, for a Mac reached by name. -->
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.siliconoptimizer.buddy.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>siliconbuddy</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
