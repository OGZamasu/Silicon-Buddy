<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      A render takes minutes. The request has to outlive the screen that started it, so
      it runs in a foreground service — which needs a notification, and on Android 13
      and later that needs asking. The app works without it: the result is still on the
      Create tab when you come back, you are simply not told.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      An agent turn followed with the app closed: the phone carrying on a conversation
      that lives on the Mac, which is what Android 14's remoteMessaging type is for. A
      normal permission, granted at install; nothing is asked at runtime beyond the
      notification permission the approvals need anyway.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!--
      While an agent's approval card is on screen, other apps' overlays are not drawn over
      it (Window.setHideOverlayWindows, Android 12+), so nothing can sit on top of Accept.
      A normal permission, granted at install.
    -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Android 11 and later hide other packages from this one. The speech recogniser and
      the text-to-speech engine are other packages, and without these two entries
      `SpeechRecognizer.isRecognitionAvailable` answers false on a phone that has one.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SiliconBuddy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SiliconBuddy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The QR the Mac shows is also a link: tapping it here pairs without a camera. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="siliconbuddy" android:host="pair" />
            </intent-filter>
            <!--
              The widget, the tile and the launcher shortcuts all open the composer
              through this. A link is a request and not an instruction: it fills the
              box in and never sends, which is why anything on the phone being able to
              fire it is not a problem.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="siliconbuddy" android:host="ask" />
                <data android:scheme="siliconbuddy" android:host="conversation" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Text, a link or a picture from any app, asked about in place. -->
        <!--
          `taskAffinity=""` gives this its own task instead of joining MainActivity's.
          Without it a share that arrives while the app is open lands in the same task,
          where two things go wrong: `excludeFromRecents` then applies to that whole
          task, so using the share sheet takes Silicon Buddy out of the recents list
          altogether; and backing out of the share drops into the app rather than
          returning to whatever was being shared from, which is not what the back
          gesture means after a share.
        -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SiliconBuddy">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          Where a long render actually runs. Not exported: nothing outside this app may
          start work on somebody's Mac.
        -->
        <service
            android:name=".media.MediaJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Keeps /events open while an agent turn the phone is following runs with the app
          in the background, and posts one notification per approval. Not exported: only
          this app starts or stops it.
        -->
        <service
            android:name=".agents.AgentWatchService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!--
          Accept and Decline on an approval notification. Reached only through this app's
          own PendingIntents, and on Android 12 and later only after the owner has
          unlocked the phone — the actions demand it.
        -->
        <receiver
            android:name=".agents.ApprovalActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.BuddyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/buddy_widget_info" />
        </receiver>

        <!--
          The tile opens a screen and nothing else. A tile that loaded a model would be
          a destructive action one accidental tap away from a locked phone's shade.
        -->
        <service
            android:name=".tile.BuddyTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
