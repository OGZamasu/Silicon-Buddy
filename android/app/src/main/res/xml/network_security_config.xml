<?xml version="1.0" encoding="utf-8"?>
<!--
  The Mac's control API is plain HTTP on a private address: 10.0.2.2 from the emulator,
  a 100.64/10 tailnet address on a phone. There is no certificate on a tailnet to
  validate, and the Mac's own listener binds 100.64/10 or loopback and nothing else.

  What this file cannot do is express that: Android's network security config matches
  hostnames, not ranges, so there is no way to write "100.64.0.0/10" here. The Mac puts
  a raw tailnet IPv4 in the QR it shows, so turning cleartext off in base-config would
  break the product's main path on every real phone, with an error the person cannot act
  on.

  So the narrowing lives in the app instead, at the one place every request passes
  through: TailnetHost, which refuses any host that is not loopback, 10.0.2.2,
  100.64.0.0/10 or fd7a:115c:a1e0::/48, and which PairingInvite applies before a scanned
  code can name a machine. See TailnetHostTest and PairingSecurityTest.

  The named domains below are the ones that can be written down, including Tailscale's
  MagicDNS suffix for a Mac reached by name.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
