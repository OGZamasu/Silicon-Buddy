<?xml version="1.0" encoding="utf-8"?>
<!--
  Two sizes, like the iOS widget: a small square that shows the model and the last
  answer, and a wide one with room for the preset question's own button. The system
  refreshes it at its own pace; `updatePeriodMillis` is a floor of thirty minutes on
  every Android, so the widget's own button is the way to get a fresh answer now.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/glance_default_loading_layout" />
